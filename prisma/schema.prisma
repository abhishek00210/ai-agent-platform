generator client {
  provider = "prisma-client-js"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationPlan {
  FREE
  STARTER
  GROWTH
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum KnowledgeBaseStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum UploadStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  EMBEDDING
  COMPLETED
  FAILED
}

enum WebsiteSourceStatus {
  PENDING
  SCRAPING
  COMPLETED
  FAILED
}

enum FaqStatus {
  ACTIVE
  INACTIVE
}

enum ConversationChannel {
  WEB_CHAT
  VOICE
  SMS
  WHATSAPP
}

enum ConversationStatus {
  ACTIVE
  CLOSED
  ARCHIVED
}

enum SenderType {
  USER
  ASSISTANT
  SYSTEM
}

enum MessageType {
  TEXT
  SYSTEM_EVENT
  TOOL_CALL
  TOOL_RESULT
}

enum MemoryFactType {
  USER_INFO
  BUSINESS_INFO
  APPOINTMENT
  CONTACT
  PREFERENCE
  CUSTOM
}

model Organization {
  id        String             @id @default(uuid())
  name      String
  slug      String             @unique
  plan      OrganizationPlan   @default(FREE)
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  members              OrganizationMember[]
  agents               Agent[]
  knowledgeBases       KnowledgeBase[]
  documents            Document[]
  websiteSources       WebsiteSource[]
  websiteContents      WebsiteContent[]
  knowledgeChunks      KnowledgeChunk[]
  knowledgeEmbeddings  KnowledgeEmbedding[]
  faqEntries           FaqEntry[]
  ragSearchEvents      RagSearchEvent[]
  conversations        Conversation[]
  messages             Message[]
  conversationMemories ConversationMemory[]
  memoryFacts          MemoryFact[]
  invitations          OrganizationInvitation[]
  auditEvents          AuditEvent[]

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(INVITED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  memberships         OrganizationMember[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     OrganizationInvitation[] @relation("OrganizationInvitationInviter")
  auditEvents         AuditEvent[]             @relation("AuditEventActor")
  uploadedDocuments   Document[]               @relation("DocumentUploader")

  @@index([email])
  @@index([status])
  @@index([deletedAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String
  expiresAt  DateTime
  deviceInfo String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model OrganizationMember {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([deletedAt])
}

model OrganizationInvitation {
  id             String     @id @default(uuid())
  organizationId String
  email          String
  role           MemberRole @default(MEMBER)
  invitedById    String
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrganizationInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([acceptedAt])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model Agent {
  id             String      @id @default(uuid())
  organizationId String
  name           String
  description    String?
  language       String      @default("en-US")
  voice          String      @default("alloy")
  systemPrompt   String      @db.Text
  status         AgentStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBases  KnowledgeBase[]
  ragSearchEvents RagSearchEvent[]
  conversations   Conversation[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@map("agents")
}

model KnowledgeBase {
  id             String              @id @default(uuid())
  organizationId String
  agentId        String?
  name           String
  description    String?
  status         KnowledgeBaseStatus @default(DRAFT)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  documents       Document[]
  websiteSources  WebsiteSource[]
  knowledgeChunks KnowledgeChunk[]
  faqEntries      FaqEntry[]
  ragSearchEvents RagSearchEvent[]

  @@index([organizationId])
  @@index([agentId])
  @@index([status])
  @@index([deletedAt])
  @@map("knowledge_bases")
}

model WebsiteSource {
  id              String              @id @default(uuid())
  organizationId  String
  knowledgeBaseId String
  url             String
  title           String?
  description     String?
  status          WebsiteSourceStatus @default(PENDING)
  contentLength   Int                 @default(0)
  lastScrapedAt   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  content       WebsiteContent?
  chunks        KnowledgeChunk[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([status])
  @@index([createdAt])
  @@index([lastScrapedAt])
  @@index([deletedAt])
  @@map("website_sources")
}

model WebsiteContent {
  id              String   @id @default(uuid())
  websiteSourceId String   @unique
  organizationId  String
  content         String   @db.Text
  htmlContent     String   @db.Text
  wordCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  websiteSource WebsiteSource @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([wordCount])
  @@map("website_content")
}

model Document {
  id               String           @id @default(uuid())
  organizationId   String
  knowledgeBaseId  String
  name             String
  description      String?
  fileName         String?
  originalFileName String?
  fileType         String?
  fileExtension    String?
  fileSize         Int?
  storagePath      String?
  storageProvider  String?
  storageBucket    String?
  uploadStatus     UploadStatus     @default(PENDING)
  processingStatus ProcessingStatus @default(PENDING)
  uploadedBy       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  uploader      User?            @relation("DocumentUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  chunks        KnowledgeChunk[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([createdAt])
  @@index([uploadedBy])
  @@index([uploadStatus])
  @@index([processingStatus])
  @@index([deletedAt])
  @@map("documents")
}

model KnowledgeChunk {
  id              String   @id @default(uuid())
  organizationId  String
  knowledgeBaseId String
  documentId      String?
  websiteSourceId String?
  faqEntryId      String?
  chunkIndex      Int
  chunkText       String   @db.Text
  tokenCount      Int
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase       @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  document      Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  websiteSource WebsiteSource?      @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)
  faqEntry      FaqEntry?           @relation(fields: [faqEntryId], references: [id], onDelete: Cascade)
  embedding     KnowledgeEmbedding?

  @@unique([documentId, chunkIndex])
  @@unique([websiteSourceId, chunkIndex])
  @@unique([faqEntryId, chunkIndex])
  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([documentId])
  @@index([websiteSourceId])
  @@index([faqEntryId])
  @@index([chunkIndex])
  @@index([createdAt])
  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
  id              String   @id @default(uuid())
  organizationId  String
  chunkId         String   @unique
  embeddingModel  String
  embeddingVector Float[]
  dimensions      Int
  createdAt       DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunk        KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([embeddingModel])
  @@index([dimensions])
  @@index([createdAt])
  @@map("knowledge_embeddings")
}

model Conversation {
  id             String              @id @default(uuid())
  organizationId String
  agentId        String
  visitorId      String?
  sessionId      String?
  channel        ConversationChannel
  status         ConversationStatus  @default(ACTIVE)
  startedAt      DateTime            @default(now())
  lastMessageAt  DateTime?
  endedAt        DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        Agent                @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages     Message[]
  memories     ConversationMemory[]
  memoryFacts  MemoryFact[]

  @@index([organizationId])
  @@index([agentId])
  @@index([visitorId])
  @@index([sessionId])
  @@index([channel])
  @@index([status])
  @@index([startedAt])
  @@index([lastMessageAt])
  @@index([deletedAt])
  @@map("conversations")
}

model ConversationMemory {
  id             String   @id @default(uuid())
  organizationId String
  conversationId String
  summary        String   @db.Text
  messageCount   Int
  tokenEstimate  Int
  generatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
  @@index([messageCount])
  @@index([generatedAt])
  @@map("conversation_memories")
}

model MemoryFact {
  id             String         @id @default(uuid())
  organizationId String
  conversationId String
  factType       MemoryFactType @default(CUSTOM)
  factKey        String
  factValue      String         @db.Text
  confidence     Float          @default(0.7)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
  @@index([factType])
  @@index([factKey])
  @@index([createdAt])
  @@map("memory_facts")
}

model Message {
  id             String      @id @default(uuid())
  organizationId String
  conversationId String
  senderType     SenderType
  content        String      @db.Text
  messageType    MessageType @default(TEXT)
  tokenCount     Int         @default(0)
  metadata       Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
  @@index([senderType])
  @@index([messageType])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("messages")
}

model FaqEntry {
  id              String    @id @default(uuid())
  organizationId  String
  knowledgeBaseId String
  question        String
  answer          String    @db.Text
  status          FaqStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        KnowledgeChunk[]

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("faq_entries")
}

model RagSearchEvent {
  id                 String   @id @default(uuid())
  organizationId     String
  knowledgeBaseId    String?
  agentId            String?
  query              String
  source             String
  resultCount        Int
  averageScore       Float
  responseTimeMs     Int
  failed             Boolean  @default(false)
  usedDocumentChunks Int      @default(0)
  usedWebsiteChunks  Int      @default(0)
  usedFaqChunks      Int      @default(0)
  createdAt          DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull)
  agent         Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([knowledgeBaseId])
  @@index([agentId])
  @@index([source])
  @@index([failed])
  @@index([createdAt])
  @@map("rag_search_events")
}
