NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_agent_platform?schema=public
DATABASE_POOL_MAX=20
DATABASE_QUERY_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379

API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
HTTP_AUTO_LOGGING=true
JWT_ACCESS_SECRET=replace-with-access-secret
JWT_REFRESH_SECRET=replace-with-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
VOICE_WEBHOOK_BASE_URL=http://localhost:4000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_MS=30000
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
TRANSCRIPTION_WORKER_CONCURRENCY=3
TRANSCRIPTION_MAX_ATTEMPTS=5
REALTIME_MAX_BUFFERED_AUDIO_PACKETS=100
REALTIME_MAX_BUFFERED_AUDIO_BYTES=65536
REALTIME_PERSISTENCE_QUEUE_SIZE=1000
REALTIME_VAD_THRESHOLD=0.5
REALTIME_VAD_PREFIX_PADDING_MS=300
REALTIME_VAD_SILENCE_DURATION_MS=400
VOICE_ROUTING_CACHE_TTL_MS=30000
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_RAG_MODEL=gpt-5.2
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.2
RAG_MAX_CONTEXT_LENGTH=6000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
